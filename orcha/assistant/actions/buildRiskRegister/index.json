{
  "name": "build_risk_register",
  "description": "Create and rank a structured risk register from identified project or operational risks.",
  "execution": "local",
  "sideEffect": false,
  "parameters": {
    "type": "object",
    "properties": {
      "risks": {
        "type": "array",
        "minItems": 1,
        "maxItems": 30,
        "items": {
          "type": "object",
          "properties": {
            "risk": { "type": "string", "maxLength": 240 },
            "likelihood": { "type": "number", "minimum": 1, "maximum": 5 },
            "impact": { "type": "number", "minimum": 1, "maximum": 5 },
            "mitigation": { "type": "string", "maxLength": 500 }
          },
          "required": ["risk", "likelihood", "impact", "mitigation"],
          "additionalProperties": false
        }
      }
    },
    "required": ["risks"],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "risks": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "risk": { "type": "string" },
            "score": { "type": "number" },
            "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
            "mitigation": { "type": "string" }
          },
          "required": ["risk", "score", "severity", "mitigation"],
          "additionalProperties": false
        }
      }
    },
    "required": ["risks"],
    "additionalProperties": false
  }
}
