{
  "name": "create_checklist",
  "description": "Create a normalized, numbered checklist from safe plain-text tasks.",
  "execution": "local",
  "sideEffect": false,
  "parameters": {
    "type": "object",
    "properties": {
      "title": { "type": "string", "maxLength": 120 },
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 12,
        "items": { "type": "string", "maxLength": 240 }
      }
    },
    "required": ["title", "items"],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "title": { "type": "string" },
      "items": { "type": "array", "items": { "type": "object" } },
      "count": { "type": "number" }
    },
    "required": ["title", "items", "count"]
  }
}
