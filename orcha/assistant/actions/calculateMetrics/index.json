{
  "name": "calculate_metrics",
  "description": "Calculate reliable summary statistics for a list of numeric values.",
  "execution": "local",
  "sideEffect": false,
  "parameters": {
    "type": "object",
    "properties": {
      "label": { "type": "string", "maxLength": 120 },
      "values": {
        "type": "array",
        "minItems": 1,
        "maxItems": 1000,
        "items": { "type": "number" }
      }
    },
    "required": ["label", "values"],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "label": { "type": "string" },
      "count": { "type": "number" },
      "sum": { "type": "number" },
      "average": { "type": "number" },
      "minimum": { "type": "number" },
      "maximum": { "type": "number" }
    },
    "required": ["label", "count", "sum", "average", "minimum", "maximum"],
    "additionalProperties": false
  }
}
