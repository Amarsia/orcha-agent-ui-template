{
  "name": "Creates a launch checklist",
  "description": "Uses create_checklist when the user asks for concrete next steps.",
  "input": {
    "content": "Give me a short checklist for launching a landing page."
  },
  "actions": {
    "create_checklist": {
      "responses": [
        {
          "output": {
            "title": "Launch landing page",
            "items": [
              { "position": 1, "label": "Write the headline", "completed": false },
              { "position": 2, "label": "Add a primary CTA", "completed": false }
            ],
            "count": 2
          }
        }
      ]
    }
  },
  "expect": {
    "status": "completed",
    "text": {
      "contains": ["headline"]
    },
    "actions": [
      {
        "name": "create_checklist"
      }
    ]
  }
}
