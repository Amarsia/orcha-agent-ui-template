{
  "schemaVersion": 1,
  "slug": "orcha-agent-ui",
  "name": "Agent UI",
  "description": "A production-ready OrchaJS agent workspace with streaming, durable Amarsia cloud sessions, execution traces, and client actions.",
  "repository": "Amarsia/orcha-agent-ui-template",
  "framework": "nextjs",
  "category": "agent",
  "agent": {
    "entrypoint": "orcha/index.ts",
    "defaultAgent": "assistant"
  },
  "environment": {
    "required": [
      { "key": "AMARSIA_PROJECT_KEY", "label": "Amarsia project key", "secret": true }
    ],
    "optional": [
      { "key": "AMARSIA_API_URL", "label": "Amarsia API endpoint", "secret": false }
    ]
  },
  "deployment": {
    "type": "container",
    "port": 3000
  }
}
